  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
