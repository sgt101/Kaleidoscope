# Server (loaded from .env automatically)
PORT=3000
# Loopback by default. 0.0.0.0 exposes the compile endpoint to your network: only do that behind your own auth.
HOST=127.0.0.1
# Extra host names the app may be reached by (comma separated), e.g. when behind a reverse proxy
ALLOWED_HOSTS=

# Folder the file browser may list, open and save text files in (default: ./documents)
WORKSPACE_DIR=

# The assistant: model providers (see README, "The assistant"). ./run_contained.sh --setup is the easy way to choose them.
# With no provider list at all these are the defaults:
# a local MLX server (mlx_lm.server), and Claude / OpenAI when their keys are set. In the container, all of these are read
# by the bridge on this machine, and none of them goes into the container. On a Mac, a key left empty here is looked for in the
# Keychain, under the same name or the provider's "keychain" name in providers.json.
MLX_URL=http://127.0.0.1:8081/v1
MLX_MODEL=default_model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Or name a file that describes the providers, in place of the one setup saved (see providers.example.json)
PROVIDERS_FILE=

# The bridge (bridge.js). ./run_contained.sh sets the token itself, new each run; with Docker Compose set one here, and start
# `node bridge.js` yourself. On Linux set BRIDGE_HOST to the Docker bridge's gateway address (often 172.17.0.1).
BRIDGE_PORT=8793
BRIDGE_HOST=127.0.0.1
BRIDGE_TOKEN=

# Trifle as an optional provider: its bridge URL and access token (defaults: ports 8792 then 8787, ~/.config/trifle/token)
TRIFLE_URL=
TRIFLE_TOKEN=
TRIFLE_TOKEN_FILE=
# Longest wait for a Trifle answer, in milliseconds (default 300000)
TRIFLE_TIMEOUT_MS=

# TeX engines and tools; leave empty to use them from PATH (or /Library/TeX/texbin)
PDFLATEX_PATH=
LUALATEX_PATH=
XELATEX_PATH=
BIBTEX_PATH=
BIBER_PATH=
