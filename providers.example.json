{
  "default": "mlx",
  "providers": [
    {
      "id": "mlx",
      "label": "MLX (local)",
      "kind": "openai",
      "url": "http://127.0.0.1:8081/v1",
      "model": "default_model",
      "contextChars": 32000
    },
    {
      "id": "claude",
      "label": "Claude",
      "kind": "anthropic",
      "model": "claude-sonnet-5-5",
      "keyEnv": "ANTHROPIC_API_KEY"
    },
    {
      "id": "openrouter",
      "label": "OpenRouter",
      "kind": "openai",
      "url": "https://openrouter.ai/api/v1",
      "model": "anthropic/claude-sonnet-5-5",
      "keyEnv": "OPENROUTER_API_KEY"
    }
  ]
}
